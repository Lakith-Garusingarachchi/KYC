# Where the Next.js server forwards /api/* requests (the FastAPI backend).
# Local dev: http://localhost:8000   Docker compose: http://backend:8000
BACKEND_URL=http://localhost:8000

# MediaPipe face landmark model used for the live head-turn guidance.
# Default: the copy in public/mediapipe (see scripts/download-face-model.sh);
# falls back to Google's hosted copy when the local file is missing.
NEXT_PUBLIC_FACE_LANDMARKER_URL=/mediapipe/face_landmarker.task
