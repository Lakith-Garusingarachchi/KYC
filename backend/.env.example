# ============================================================================
# KYC backend settings. Copy to .env and fill in. Never commit .env.
# ============================================================================

# --- LLM adapter selection ------------------------------------------------------
# Which el-aiee adapter reads the documents and reviews the face frames.
# Needs a vision model:  gemini | gemini_vertex | openai | claude
# deepseek is text-only: use it only as LLM_TEXT_PROVIDER.
LLM_PROVIDER=gemini
# Optional: a different (cheaper/text-only) adapter for the address comparison.
# Empty = same as LLM_PROVIDER.
LLM_TEXT_PROVIDER=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=4096

# Gemini (Google AI Studio API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini on Vertex AI (GCP project billing, service-account JSON)
# Put the key file at backend/secrets/vertex-sa.json (mounted read-only in Docker).
VERTEX_SERVICE_ACCOUNT_FILE=secrets/vertex-sa.json
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# DeepSeek (text only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Login: OAuth2 password flow + JWT ---------------------------------------------
# Signs the login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# true when served over HTTPS
AUTH_COOKIE_SECURE=false

# Optional "Continue with Google" (OAuth client from Google Cloud Console).
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- App ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
# Default: SQLite in backend/data. Postgres: postgresql+asyncpg://user:pass@host/db (add asyncpg)
# DATABASE_URL=sqlite+aiosqlite:///./data/kyc.db
# Encrypts uploaded documents and face frames at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# --- Face / liveness thresholds --------------------------------------------------------
FACE_MATCH_THRESHOLD=0.363
FACE_REJECT_THRESHOLD=0.25
LIVENESS_YAW_DELTA=0.10
LIVENESS_PITCH_DELTA=0.05

# --- Document rules -----------------------------------------------------------------------
BILL_MAX_AGE_DAYS=90
NAME_MATCH_THRESHOLD=80
ADDRESS_MATCH_THRESHOLD=75
